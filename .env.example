AI_ENABLED=true
AI_MODE=mock
AI_SERVICE_URL=
# Compose defaults to http://policy-agent:8001 (the bundled agent) when this is blank.
POLICY_AGENT_URL=
# Policy agent embeddings. The key is REQUIRED: every policy search embeds the query live.
EMBEDDING_API_KEY=
# Base URL of your OpenAI-compatible embedding endpoint (blank = api.openai.com).
# The bundled cache in policy-agent/data/cache was built with bge-small-en-v1.5 (384-dim),
# so that is the default model; changing it forces a full re-embed through the API.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-en-v1.5
AI_TIMEOUT_SECONDS=10
RECEIPT_EXTRACTION_MODE=local
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Host port for the web UI. Change it if 5173 is busy; CORS follows automatically.
WEB_PORT=5173

# Optional prefix for base images (e.g. a Docker Hub mirror). Must end with "/". Empty = Docker Hub.
REGISTRY=
# Optional package mirrors used during image builds (defaults: public PyPI / npm).
PIP_INDEX_URL=
NPM_CONFIG_REGISTRY=
